# ==============================================================================
# VeriBhoomi AI — Master Environment Configuration Template
# ==============================================================================

# Backend Port & Gating
PORT=8000
ALLOW_SQLITE_FALLBACK=true

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 14+ with PostGIS 3.4+ Required for Demo/Prod)
# ------------------------------------------------------------------------------
# Option A: Supabase Production Deployment
# 1. Transaction Pooler (PgBouncer Port 6543) — Used by FastAPI backend connection pool
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# 2. Direct Session Connection (Port 5432) — Used for DDL migrations, PostGIS extension creation, and spatial indexes
# DATABASE_URL_MIGRATIONS=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Option B: Local Docker PostGIS (docker-compose up -d)
# DATABASE_URL=postgresql://veribhoomi:veribhoomi_password_2026@localhost:5432/veribhoomi_db

# Option C: Local SQLite Fallback (Development & Isolated Test Suites Only)
DATABASE_URL=sqlite:///./veribhoomi.db

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=veribhoomi-super-secret-jwt-key-2026-sih
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Microservices & External Gateways
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8001
MOCK_LRMS_URL=http://localhost:8002

# Storage
STORAGE_DIR=./storage

# ------------------------------------------------------------------------------
# Cloud Vision / Document AI Fallback (Task 2)
# Triggered when document quality score < 45.0% or local OCR confidence < 60.0%
# ------------------------------------------------------------------------------
# GOOGLE_CLOUD_VISION_KEY=AIzaSyYourGoogleCloudVisionApiKeyHere
# CLOUD_VISION_API_KEY=AIzaSyYourGoogleCloudVisionApiKeyHere
# AZURE_FORM_RECOGNIZER_ENDPOINT=https://[YOUR-RESOURCE].cognitiveservices.azure.com/
# AZURE_FORM_RECOGNIZER_KEY=YourAzureKeyHere

# ------------------------------------------------------------------------------
# n8n Automation & Webhooks
# ------------------------------------------------------------------------------
ENABLE_N8N_WEBHOOKS=true
N8N_WEBHOOK_URL=http://localhost:5678/webhook/veribhoomi-events

